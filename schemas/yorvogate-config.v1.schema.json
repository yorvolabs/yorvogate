{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yorvolabs/yorvogate/schemas/yorvogate-config.v1.schema.json",
  "title": "YorvoGate configuration, format 1",
  "description": "The YAML configuration (docs/configuration.md). YorvoGate itself is stricter in places (an address's host and port, a path's form, the listeners' names and addresses being their own): run yorvogate check. The version is required from YorvoGate 0.4 (0.3 read a file without one as version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "upstream", "listeners"],
  "properties": {
    "version": {"const": 1},
    "upstream": {"type": "string", "pattern": "^unix:///"},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {"$ref": "#/$defs/apiVersion"},
        "max": {"$ref": "#/$defs/apiVersion"}
      }
    },
    "body_limit": {"type": "integer", "minimum": 4096, "maximum": 67108864},
    "load_limit": {"type": "integer", "minimum": 1048576, "maximum": 274877906944},
    "state_file": {"type": "string", "pattern": "^/.*[^/]$"},
    "admin": {"type": "object", "additionalProperties": false, "required": ["address"], "properties": {"address": {"type": "string", "pattern": "^(unix:///|tcp://)"}, "socket_group": {"type": "string"}, "scope_labels": {"type": "boolean"}}},
    "spool": {"type": "object", "additionalProperties": false, "properties": {"dir": {"type": "string", "pattern": "^/"}, "limit": {"type": "integer", "minimum": 1048576, "maximum": 1099511627776}, "loads": {"type": "integer", "minimum": 1, "maximum": 64}, "ratio": {"type": "integer", "anyOf": [{"const": 0}, {"minimum": 2, "maximum": 1000}]}, "unpacked": {"type": "integer", "minimum": 67108864, "maximum": 4398046511104}}},
    "daemon": {"type": "object", "additionalProperties": false, "properties": {"without_lsm": {"type": "boolean"}}},
    "shutdown_grace": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$", "description": "How long a stop waits for requests and streams to end before it closes them: a Go duration from 0s to 10m (default 8s)."},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "What every listener's connections may hold together. Changed only by a restart.",
      "properties": {
        "connections": {"type": "integer", "minimum": 16, "maximum": 1048576, "description": "Connections every listener may have open together (default 4096)."}
      }
    },
    "listeners": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/listener"}}
  },
  "$defs": {
    "apiVersion": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)$"},
    "absolute": {"type": "string", "pattern": "^/"},
    "pin": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "address": {"type": "string", "pattern": "^(tcp://.+:[0-9]+|unix:///.*)$"},
        "mode": {"enum": ["trusted", "scoped"]},
        "scope_sockets": {"$ref": "#/$defs/absolute"},
        "socket_group": {"anyOf": [{"type": "string", "pattern": "^([a-z_][a-z0-9_-]{0,31}|[0-9]{1,10})$"}, {"type": "integer", "minimum": 0, "maximum": 9999999999}]},
        "allow": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["system", "containers", "exec", "images", "build", "networks", "volumes", "distribution", "plugins", "swarm", "session"]},
          "additionalProperties": {"enum": ["read", "write"]}
        },
        "scopes": {"$ref": "#/$defs/absolute"},
        "containers": {"$ref": "#/$defs/containers"},
        "builder_apparmor_profiles": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"}},
        "allow_privileged_builders": {"type": "boolean"},
        "pulls": {"$ref": "#/$defs/pulls"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certificate", "key"],
          "properties": {
            "certificate": {"$ref": "#/$defs/absolute"},
            "key": {"$ref": "#/$defs/absolute"},
            "client_ca": {"$ref": "#/$defs/absolute"}
          }
        },
        "plaintext": {"const": "i-understand"},
        "clients": {"type": "array", "items": {"$ref": "#/$defs/pin"}},
        "require_peer_uids": {"type": "boolean"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "A scoped listener's: what one scope may hold on it.",
          "properties": {
            "connections": {"type": "integer", "minimum": 1, "maximum": 4096, "description": "Connections one scope may have open (default 64)."},
            "requests": {"type": "integer", "minimum": 1, "maximum": 4096, "description": "Requests one scope may have in flight, streams included (default 64)."}
          }
        }
      },
      "oneOf": [
        {"required": ["address"], "not": {"required": ["scope_sockets"]}},
        {"required": ["scope_sockets"], "not": {"required": ["address"]}, "properties": {"mode": {"const": "scoped"}}}
      ],
      "if": {"properties": {"mode": {"const": "trusted"}}},
      "then": {
        "required": ["allow"],
        "not": {"anyOf": [{"required": ["scopes"]}, {"required": ["containers"]}, {"required": ["builder_apparmor_profiles"]}, {"required": ["allow_privileged_builders"]}, {"required": ["pulls"]}, {"required": ["require_peer_uids"]}, {"required": ["limits"]}]}
      },
      "else": {"required": ["scopes"], "not": {"anyOf": [{"required": ["allow"]}, {"required": ["clients"]}]}}
    },
    "containers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z_]{1,31}$", "not": {"anyOf": [{"pattern": "^CAP_"}, {"const": "ALL"}]}}},
        "drop_all_capabilities": {"type": "boolean"},
        "no_new_privileges": {"type": "boolean"},
        "security_options": {"type": "array", "items": {"type": "string", "pattern": "^[^ \\t\\n]+$"}},
        "runtimes": {"$ref": "#/$defs/names"},
        "log_drivers": {"$ref": "#/$defs/names"},
        "log_options": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "max_log_buffer": {"type": "integer", "minimum": 0},
        "ulimits": {"$ref": "#/$defs/names"},
        "max_memory": {"type": "integer", "anyOf": [{"const": 0}, {"minimum": 6291456}]},
        "max_pids": {"type": "integer", "minimum": 0},
        "protected_images": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,254}/$"}},
        "egress": {"enum": ["none"]}
      }
    },
    "pulls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registries": {"type": "array", "items": {"type": "string", "pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*)(:[0-9]{1,5})?$"}},
        "platforms": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+(/[a-z0-9_.-]+)?$"}}
      }
    },
    "names": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}
  }
}
