{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yorvolabs/yorvogate/schemas/yorvogate-log.v1.schema.json",
  "title": "YorvoGate log line, format 1",
  "description": "One JSON line on standard error (docs/configuration.md#logs). Open for additions at every level (ADR-0005, amendment 1): a later release may add optional fields within log_version 1, and values to an open list (x-list: open), so ignore fields you don't know and take an unknown value of an open list as is. A removed field, or one whose meaning changes, is a new log_version. code is the contract for refusals; reason is free text for people.",
  "type": "object",
  "additionalProperties": true,
  "required": ["time", "level", "msg"],
  "properties": {
    "time": {"type": "string"},
    "level": {"enum": ["DEBUG", "INFO", "WARN", "ERROR"], "x-list": "closed", "description": "Closed: the levels."},
    "msg": {"type": "string", "x-list": "open", "examples": ["allowed", "refused", "auth failed", "stream opened", "stream closed", "configuration reloaded", "configuration not reloaded", "stopping", "stopped"]},
    "log_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "client_request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "listener": {"type": "string"},
    "source": {"type": "string", "description": "The TCP peer's address (IP:port), uid=<n> for a unix socket's peer, or unix when it isn't known."},
    "method": {"type": "string"},
    "path": {"type": "string", "maxLength": 260},
    "endpoint": {"type": "string"},
    "scope": {"type": "string"},
    "status": {"type": "integer"},
    "code": {"type": "string", "pattern": "^[a-z]+\\.[a-z-]+$", "x-list": "open", "description": "Open: docs/configuration.md#reason-codes. A cause keeps its code."},
    "codes": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z]+\\.[a-z-]+$"}, "description": "Every problem's code, when there are several: the first 32."},
    "codes_total": {"type": "integer", "minimum": 2, "description": "How many problems there were (codes has the first 32)."},
    "reason": {"type": "string"},
    "decision_ms": {"type": "number", "minimum": 0},
    "headers_not_forwarded": {"type": "array", "items": {"type": "string"}},
    "auth_failure": {"type": "string", "x-list": "open", "examples": ["no-credentials", "unknown-scope", "wrong-token", "token-expired", "peer-not-allowed", "certificate-not-pinned", "certificate-expired", "scope-file-invalid", "names-another", "token-on-certificate-listener"]},
    "claimed_scope": {"type": "string", "maxLength": 68},
    "duration_ms": {"type": "number", "minimum": 0},
    "bytes_in": {"type": "integer", "minimum": 0},
    "bytes_out": {"type": "integer", "minimum": 0},
    "by": {"type": "string", "x-list": "open", "examples": ["ended", "revoked", "shutdown", "reload"], "description": "ended: by the client or Docker; revoked: its scope or credential no longer allows it; shutdown: YorvoGate stopped; reload: a reload removed or moved its listener."}
  },
  "allOf": [
    {"if": {"properties": {"msg": {"enum": ["allowed", "refused"]}}, "required": ["msg"]},
     "then": {"required": ["log_version", "request_id", "listener", "source", "method", "path", "decision_ms"]}},
    {"if": {"properties": {"msg": {"const": "refused"}}, "required": ["msg"]},
     "then": {"required": ["status", "code", "reason"]}},
    {"if": {"properties": {"msg": {"const": "auth failed"}}, "required": ["msg"]},
     "then": {"required": ["log_version", "request_id", "listener", "source", "auth_failure"]}},
    {"if": {"properties": {"msg": {"enum": ["stream opened", "stream closed"]}}, "required": ["msg"]},
     "then": {"required": ["log_version", "request_id", "listener"]}},
    {"if": {"properties": {"msg": {"const": "stream closed"}}, "required": ["msg"]},
     "then": {"required": ["duration_ms", "bytes_in", "bytes_out", "by"]}}
  ]
}
