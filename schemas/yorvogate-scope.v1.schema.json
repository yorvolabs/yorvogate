{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yorvolabs/yorvogate/schemas/yorvogate-scope.v1.schema.json",
  "title": "YorvoGate scope file, format 1",
  "description": "<scopes>/<name>.json (docs/configuration.md#scope-files-scoped-listeners). token_sha256 (or tokens: at most 8 with token_sha256, each listed once) is optional only on a listener with scope sockets or mTLS (tls.client_ca), where the client certificate is the scope; peer_uids only where every listener of the folder is on a unix address; certificates (its public keys) only on an mTLS listener. YorvoGate also refuses a scope that shares an owner label, prefix, image namespace or builder with another: run yorvogate check. Without version, a file is read as version 1 until YorvoGate 0.4, which requires it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "prefixes"],
  "properties": {
    "version": {"const": 1},
    "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokens": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "expires": {"type": "string", "format": "date-time"}}}},
    "peer_uids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
      }
    },
    "prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}[-_.]$", "not": {"pattern": "^[0-9a-f]{12}_"}}},
    "images": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,254}/$"}},
    "networks": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aliases": {"type": "array", "items": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?)*$", "not": {"pattern": "(^|\\.)([0-9a-f]{12}|[0-9a-f]{64})(\\.|$)"}}},
          "addresses": {"type": "array", "items": {"type": "string", "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]}}
        }
      }
    },
    "builders": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"}},
    "subnets": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
    "egress": {"enum": ["none"]},
    "certificates": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
